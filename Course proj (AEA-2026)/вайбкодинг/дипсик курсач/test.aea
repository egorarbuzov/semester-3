// ============================================================
// Контрольный пример для языка IVA-2026
// Группа 8, вариант 1
// ============================================================

uint8 a = 5;
uint8 b = 3;
bool flag = true;
string msg = "result";

func uint8 bitOr(uint8 x, uint8 y) {
    return x | y;
}

func uint8 bitAnd(uint8 x, uint8 y) {
    return x & y;
}

func uint8 bitNot(uint8 x) {
    return ~x;
}

main {
    uint8 c = bitOr(a, b);
    print("a | b = ");
    print(intToStr(c));

    uint8 d = bitAnd(a, b);
    print("a & b = ");
    print(intToStr(d));

    uint8 e = bitNot(a);
    print("~a    = ");
    print(intToStr(e));

    uint8 i = 0;
    do {
        print("iter");
        print(intToStr(i));
        i = i + 1;
    } while (i < 3);

    if flag {
        print("flag is true");
    } else {
        print("flag is false");
    }

    print("msg length:");
    print(intToStr(strLen(msg)));
}